# ===================================
# MotoPuzzle — Environment Variables
# ===================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# WordPress GraphQL API endpoint
# Локально: http://api-motopuzzle.local/graphql
# Production: https://api.motopuzzle.net/graphql
WORDPRESS_API_URL=http://api-motopuzzle.local/graphql

# WordPress site URL (для загрузки медиа-файлов)
WORDPRESS_URL=http://api-motopuzzle.local

# Публичный URL фронтенда (для sitemap, canonical, OG-тегов)
# В Astro доступна как import.meta.env.SITE (если задан в astro.config)
PUBLIC_SITE_URL=http://motopuzzle.local
