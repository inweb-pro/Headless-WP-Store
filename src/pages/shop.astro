---
import ShopLayout from "../layouts/ShopLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import LoadMore from "../components/LoadMore.astro";

const apiUri = import.meta.env.WORDPRESS_API_URL;
const response = await fetch(apiUri, {
	method: "POST",
	headers: { "Content-Type": "application/json" },
	body: JSON.stringify({
		query: `query GetShop { products(first: 12) { pageInfo { hasNextPage, endCursor }, found, nodes { name, uri, ... on ProductWithPricing { price }, image { sourceUrl } } } }`,
	}),
});
const { data } = await response.json();
const products = data?.products;
const totalCount = products?.found || 0;
---

<ShopLayout title="Каталог">
	<div class="content-wrapper">
		<Breadcrumbs items={[{ name: "Каталог" }]} />
		<section class="catalog-view">
			<h1>Все товары (<span>{totalCount}</span>)</h1>
			<div id="products-grid" class="products-grid">
				{products?.nodes.map((p) => <ProductCard product={p} />)}
			</div>
			{
				products?.pageInfo.hasNextPage && (
					<div class="load-more-container">
						<LoadMore cursor={products.pageInfo.endCursor} api={apiUri} />
					</div>
				)
			}
		</section>
	</div>
</ShopLayout>

<script>
	const btn = document.getElementById("load-more-btn") as HTMLButtonElement;
	const grid = document.getElementById("products-grid");

	if (btn && grid) {
		const apiUri = btn.getAttribute("data-api")!;
		const defaultContent = btn.querySelector(
			".btn-default-content",
		) as HTMLElement;
		const loadingContent = btn.querySelector(
			".btn-loading-content",
		) as HTMLElement;

		btn.addEventListener("click", async () => {
			const cursor = btn.getAttribute("data-cursor");
			btn.disabled = true;
			btn.classList.add("is-loading");
			defaultContent.style.display = "none";
			loadingContent.style.display = "flex";

			try {
				const res = await fetch(apiUri, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						query: `query LoadMore($after: String) { products(first: 12, after: $after) { pageInfo { hasNextPage, endCursor }, nodes { name, uri, ... on ProductWithPricing { price }, image { sourceUrl } } } }`,
						variables: { after: cursor },
					}),
				});
				const { data } = await res.json();
				const next = data.products;

				next.nodes.forEach((p: any) => {
					const container = document.createElement("div");
					container.innerHTML = `<article class="product-card"><a href="${p.uri}" class="product-link"><div class="image-wrapper"><img src="${p.image?.sourceUrl || "/placeholder.jpg"}" alt="${p.name}" loading="lazy" /></div><h3 class="product-name">${p.name}</h3><p class="product-price">${p.price || "Цена по запросу"}</p></a></article>`;
					grid.appendChild(container.firstElementChild!);
				});

				if (next.pageInfo.hasNextPage) {
					btn.setAttribute("data-cursor", next.pageInfo.endCursor);
					btn.disabled = false;
					btn.classList.remove("is-loading");
					defaultContent.style.display = "flex";
					loadingContent.style.display = "none";
				} else {
					btn.remove();
				}
			} catch (e) {
				console.error(e);
				btn.disabled = false;
			}
		});
	}
</script>
