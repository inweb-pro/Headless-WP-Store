		display: none;
		flex-direction: column;
		gap: 16px;
	}

	.auth-form.is-active {
		display: flex;
	}

	.btn-auth-submit {
		background: var(--color-primary, #ffdd00);
		color: #1a1a1a;
		border: none;
		border-radius: 6px;
		padding: 13px;
		font-size: 14px;
		font-weight: 700;
		text-transform: uppercase;
		cursor: pointer;
		margin-top: 6px;
		transition: background 0.15s;
	}

	.btn-auth-submit:hover {
		background: #e6c700;
	}

	.form-error {
		background: #ffebee;
		color: #c62828;
		border: 1px solid #ffcdd2;
		border-radius: 6px;
		padding: 8px 12px;
		font-size: 13px;
	}
</style>

<script>
	import { initPhoneMask } from '../scripts/phone-mask.js';
	import { initPassportMask } from '../scripts/passport-mask.js';

	// 1. Инициализация масок для полей профиля
	const phoneInput = document.getElementById('profile-phone');
	if (phoneInput) {
		initPhoneMask(phoneInput);
	}

	const passportInput = document.getElementById('profile-passport');
	if (passportInput) {
		initPassportMask(passportInput);
	}

	// 2. Переключение табов Личного кабинета (Заказы / Мои данные)
	const accountTabs = document.querySelectorAll('.account-nav-tab');
	const ordersPane = document.getElementById('tab-orders-content');
	const profilePane = document.getElementById('tab-profile-content');
	const editTriggerBtn = document.getElementById('btn-edit-profile-trigger');

	function switchAccountTab(tabName: string) {
		accountTabs.forEach((tab) => {
			const active = tab.getAttribute('data-account-tab') === tabName;
			tab.classList.toggle('is-active', active);
		});

		if (tabName === 'profile') {
			if (profilePane) profilePane.style.display = 'block';
			if (ordersPane) ordersPane.style.display = 'none';
		} else {
			if (ordersPane) ordersPane.style.display = 'block';
			if (profilePane) profilePane.style.display = 'none';
		}

		// Обновляем URL без перезагрузки страницы
		const url = new URL(window.location.href);
		if (tabName === 'profile') {
			url.searchParams.set('tab', 'profile');
		} else {
			url.searchParams.delete('tab');
		}
		history.replaceState(null, '', url.toString());
	}

	accountTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const target = tab.getAttribute('data-account-tab') || 'orders';
			switchAccountTab(target);
		});
	});

	editTriggerBtn?.addEventListener('click', () => {
		switchAccountTab('profile');
	});

	// 3. Сохранение изменений в профиле
	const profileForm = document.getElementById('profile-edit-form') as HTMLFormElement;
	const saveBtn = document.getElementById('btn-save-profile') as HTMLButtonElement;
	const successMsg = document.getElementById('profile-success-msg');
	const errorMsg = document.getElementById('profile-error-msg');
	const displayUserName = document.getElementById('display-user-name');

	profileForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!saveBtn) return;

		if (successMsg) successMsg.style.display = 'none';
		if (errorMsg) {
			errorMsg.style.display = 'none';
			errorMsg.textContent = '';
		}

		const formData = new FormData(profileForm);
		const payload = {
			name: String(formData.get('name') || '').trim(),
			phone: String(formData.get('phone') || '').trim(),
			passport: String(formData.get('passport') || '').trim(),
			city: String(formData.get('city') || '').trim(),
			address: String(formData.get('address') || '').trim(),
		};

		// Валидация телефона (11 цифр)
		const phoneDigits = payload.phone.replace(/\D/g, '');
		if (phoneDigits.length < 11) {
			if (errorMsg) {
				errorMsg.textContent = 'Пожалуйста, укажите полный номер телефона: +7 (000) 000-00-00';
				errorMsg.style.display = 'block';
			}
			phoneInput?.focus();
			return;
		}

		// Валидация паспорта (если заполнен, должно быть 10 цифр)
		if (payload.passport) {
			const passportDigits = payload.passport.replace(/\D/g, '');
			if (passportDigits.length < 10) {
				if (errorMsg) {
					errorMsg.textContent = 'Пожалуйста, укажите полные серию и номер паспорта: 10 цифр (0000-000000)';
					errorMsg.style.display = 'block';
				}
				passportInput?.focus();
				return;
			}
		}

		saveBtn.disabled = true;
		saveBtn.textContent = 'Сохраняем...';

		try {
			const res = await fetch('/api/auth/profile', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});
			const data = await res.json();

			if (data.success) {
				if (successMsg) successMsg.style.display = 'block';
				if (displayUserName && data.user?.name) {
					displayUserName.textContent = data.user.name;
				}
			} else {
				if (errorMsg) {
					errorMsg.textContent = data.error || 'Ошибка при сохранении данных';
					errorMsg.style.display = 'block';
				}
			}
		} catch (err) {
			console.error('Save profile error:', err);
			if (errorMsg) {
				errorMsg.textContent = 'Ошибка сети. Попробуйте еще раз.';
				errorMsg.style.display = 'block';
			}
		} finally {
			saveBtn.disabled = false;
			saveBtn.textContent = 'Сохранить изменения';
		}
	});

	// 4. Переключение табов Вход / Регистрация для гостей
	const authTabs = document.querySelectorAll('.auth-tab');
	const loginForm = document.getElementById('login-form') as HTMLFormElement;
	const registerForm = document.getElementById('register-form') as HTMLFormElement;

	authTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const target = tab.getAttribute('data-tab');
			authTabs.forEach((t) => t.classList.remove('is-active'));
			tab.classList.add('is-active');

			if (target === 'login') {
				loginForm?.classList.add('is-active');
				registerForm?.classList.remove('is-active');
			} else {
				registerForm?.classList.add('is-active');
				loginForm?.classList.remove('is-active');
			}
		});
	});

	// Обработка Входа
	loginForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const errEl = document.getElementById('login-error');
		if (errEl) errEl.style.display = 'none';

		const formData = new FormData(loginForm);
		const username = formData.get('username');
		const password = formData.get('password');

		try {
			const res = await fetch('/api/auth/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ username, password }),
			});
			const data = await res.json();
			if (data.success) {
				window.location.reload();
			} else {
				if (errEl) {
					errEl.textContent = data.error || 'Ошибка входа';
					errEl.style.display = 'block';
				}
			}
		} catch (err) {
			if (errEl) {
				errEl.textContent = 'Ошибка сети. Попробуйте еще раз.';
				errEl.style.display = 'block';
			}
		}
	});

	// Обработка Регистрации
	registerForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const errEl = document.getElementById('reg-error');
		if (errEl) errEl.style.display = 'none';

		const formData = new FormData(registerForm);
		const email = formData.get('email');
		const username = formData.get('username');
		const password = formData.get('password');

		try {
			const res = await fetch('/api/auth/register', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, username, password }),
			});
			const data = await res.json();
			if (data.success) {
				window.location.reload();
			} else {
				if (errEl) {
					errEl.textContent = data.error || 'Ошибка регистрации';
					errEl.style.display = 'block';
				}
			}
		} catch (err) {
			if (errEl) {
				errEl.textContent = 'Ошибка сети. Попробуйте еще раз.';
				errEl.style.display = 'block';
			}
		}
	});

	// 5. Выход
	const logoutBtn = document.getElementById('btn-logout');
	logoutBtn?.addEventListener('click', async () => {
		try {
			await fetch('/api/auth/logout', { method: 'POST' });
			window.location.reload();
		} catch (e) {
			console.error('Logout error:', e);
		}
	});
</script>
