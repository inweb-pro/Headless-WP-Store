	/* Формы входа и регистрации */
	.auth-wrapper {
		max-width: 480px;
		margin: 30px auto;
	}

	.auth-tabs {
		display: flex;
		border-bottom: 2px solid #eee;
		margin-bottom: 20px;
	}

	.auth-tab {
		flex: 1;
		padding: 12px;
		background: none;
		border: none;
		font-size: 15px;
		font-weight: 700;
		color: #888;
		cursor: pointer;
		position: relative;
		transition: color 0.15s;
	}

	.auth-tab.is-active {
		color: #111;
	}

	.auth-tab.is-active::after {
		content: "";
		position: absolute;
		bottom: -2px;
		left: 0;
		right: 0;
		height: 3px;
