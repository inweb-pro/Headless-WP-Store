---
import ShopLayout from "../layouts/ShopLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import LoadMore from "../components/LoadMore.astro";

const { slug } = Astro.params;
if (
	slug?.includes(".js") ||
	slug?.includes(".map") ||
	slug?.startsWith("_astro")
) {
	return new Response(null, { status: 404 });
}

const slugParts = slug?.split("/").filter(Boolean) || [];
const finalSlug = slugParts[slugParts.length - 1];
const apiUri = import.meta.env.WORDPRESS_API_URL;

const response = await fetch(apiUri, {
	method: "POST",
	headers: { "Content-Type": "application/json" },
	body: JSON.stringify({
		query: `
      query GetNode($id: ID!) {
        productCategory(id: $id, idType: SLUG) {
          __typename, name, uri, count
          ancestors { nodes { name, uri } }
          products(first: 12) {
            pageInfo { hasNextPage, endCursor }
            nodes { name, uri, ... on ProductWithPricing { price }, image { sourceUrl } }
          }
        }
        product(id: $id, idType: SLUG) {
          __typename, name, uri, description, ... on ProductWithPricing { price }, image { sourceUrl }
          productCategories { nodes { name, uri, ancestors { nodes { name, uri } } } }
        }
      }
    `,
		variables: { id: finalSlug },
	}),
});

const { data } = await response.json();
const node = data?.productCategory || data?.product;
if (!node) return Astro.redirect("/404");

const isCategory = node.__typename === "ProductCategory";

// Логика крошек (остается без изменений)
let breadcrumbItems = [];
if (isCategory) {
	const ancestors = node.ancestors?.nodes
		? [...node.ancestors.nodes].reverse()
		: [];
	breadcrumbItems = [...ancestors, { name: node.name, uri: node.uri }];
} else {
	const categories = node.productCategories?.nodes || [];
	const deepestCategory = categories.reduce((deepest, current) => {
		const deepestLen = deepest?.ancestors?.nodes?.length || 0;
		const currentLen = current?.ancestors?.nodes?.length || 0;
		return currentLen > deepestLen ? current : deepest;
	}, categories[0]);
	if (deepestCategory) {
		const ancestors = deepestCategory.ancestors?.nodes
			? [...deepestCategory.ancestors.nodes].reverse()
			: [];
		breadcrumbItems = [
			...ancestors,
			{ name: deepestCategory.name, uri: deepestCategory.uri },
			{ name: node.name, uri: node.uri },
		];
	} else {
		breadcrumbItems = [{ name: node.name, uri: node.uri }];
	}
}
---

<ShopLayout title={node.name} currentUri={node.uri}>
	<div class="content-wrapper">
		<Breadcrumbs items={breadcrumbItems} />
		{
			isCategory ? (
				<section class="category-view">
					<h1>
						{node.name} ({node.count || 0})
					</h1>
					<div id="products-grid" class="products-grid">
						{node.products?.nodes.map((p) => (
							<ProductCard product={p} variant="v1" />
						))}
					</div>
					{node.products?.pageInfo.hasNextPage && (
						<LoadMore
							cursor={node.products.pageInfo.endCursor}
							slug={finalSlug}
						/>
					)}
				</section>
			) : (
				<article class="product-detail">
					<div class="product-main">
						<div class="product-image">
							<img
								src={node.image?.sourceUrl || "/placeholder.jpg"}
								alt={node.name}
							/>
						</div>

						<div class="product-info">
							<h1>{node.name}</h1>
							<div class="price-box" set:html={node.price} />
							<button class="buy-btn">В КОРЗИНУ</button>

							{node.description && (
								<div class="description">
									<h3>Описание:</h3>
									<div class="desc-content" set:html={node.description} />
								</div>
							)}
						</p>

						<div class="product-buy-wrap">
							<div class="product-qty-select">
								<button type="button" class="qty-btn" onclick="const i=this.nextElementSibling; if(parseInt(i.value)>1) i.value=parseInt(i.value)-1;">−</button>
								<input type="number" class="product-qty-input" data-product-quantity value="1" min="1" max={product.stockQuantity || 99} />
								<button type="button" class="qty-btn" onclick="const i=this.previousElementSibling; i.value=parseInt(i.value)+1;">+</button>
							</div>
							<button class="buy-btn" data-add-to-cart={product.databaseId} disabled={product.stockStatus !== 'IN_STOCK'}>
								В КОРЗИНУ
							</button>
						</div>

						<!-- Атрибуты товара (если есть помимо категорий) -->
						{attributes.length > 0 && (
							<div class="product-attributes">
								<h3>Характеристики</h3>
								<table>
									<tbody>
										{attributes.map((attr) => (
											<tr>
												<td class="attr-name">{attr.label || attr.name}</td>
												<td class="attr-value">{attr.options.join(', ')}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						)}
					</div>
				</div>

				<!-- Описание -->
				{product.description && (
					<div class="product-description">
						<h3>Описание</h3>
						<div class="desc-content" set:html={product.description} />
					</div>
				)}

				<!-- Похожие товары -->
				{related.length > 0 && (
					<section class="related-products">
						<h3>Похожие товары</h3>
						<div class="products-grid">
							{related.map((p) => <ProductCard product={p} variant="v1" />)}
						</div>
					</div>
				</article>
			)
		}
	</div>
</ShopLayout>

<style>
	/* Страница товара */
	.product-detail {
		padding: 0 0 40px;
	}

	.product-main {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 30px;
		margin-bottom: 30px;
	}

	/* Галерея */
	.product-gallery {
		position: sticky;
		top: 80px;
		align-self: start;
	}

	.gallery-main img {
		width: 100%;
		height: auto;
		border-radius: 8px;
		background: #f5f5f5;
		object-fit: contain;
		aspect-ratio: 1 / 1;
	}

	.gallery-thumbs {
		display: flex;
		gap: 8px;
		margin-top: 12px;
		flex-wrap: wrap;
	}

	.thumb {
		border: 2px solid transparent;
		border-radius: 6px;
		padding: 2px;
		cursor: pointer;
		background: #fff;
		transition: border-color 0.2s;
	}

	.thumb.active,
	.thumb:hover {
		border-color: var(--color-primary, #ffdd00);
	}

	.thumb img {
		width: 60px;
		height: 60px;
		object-fit: cover;
		border-radius: 4px;
		display: block;
	}

	/* Информация */
	.product-info h1 {
		font-size: 1.5rem;
		margin: 0 0 10px;
		line-height: 1.3;
	}

	.product-sku {
		color: #888;
		font-size: 0.85rem;
		margin: 0 0 12px;
	}

	.product-meta-cats {
		margin: 0 0 15px;
		font-size: 0.9rem;
	}

	.product-meta-cats a {
		color: var(--dark, #333);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--color-primary, #ffdd00);
		text-underline-offset: 3px;
	}

	.product-meta-cats p {
		margin: 4px 0;
	}

	.price-box {
		font-size: 1.6rem;
		font-weight: 700;
		color: #c00;
		margin: 10px 0;
	}

	.old-price {
		text-decoration: line-through;
		color: #999;
		font-size: 1rem;
		margin-top: -8px;
		margin-bottom: 10px;
	}

	.stock-status {
		font-size: 0.9rem;
		margin: 10px 0;
	}

	.in-stock {
		color: #2e7d32;
	}

	.out-of-stock {
		color: #c00;
	}

	.product-buy-wrap {
		display: flex;
		align-items: center;
		gap: 12px;
		margin: 15px 0 20px;
	}

	.product-qty-select {
		display: flex;
		align-items: center;
		border: 1px solid #ddd;
		border-radius: 6px;
		overflow: hidden;
		background: #fff;
		height: 48px;
	}

	.product-qty-select .qty-btn {
		background: #f5f5f5;
		border: none;
		width: 36px;
		height: 100%;
		cursor: pointer;
		font-size: 16px;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.15s;
	}

	.product-qty-select .qty-btn:hover {
		background: #e0e0e0;
	}

	.product-qty-input {
		width: 50px;
		height: 100%;
		border: none;
		text-align: center;
		font-size: 15px;
		font-weight: 700;
		outline: none;
		appearance: textfield;
		-moz-appearance: textfield;
	}
	.product-qty-input::-webkit-outer-spin-button,
	.product-qty-input::-webkit-inner-spin-button {
		-webkit-appearance: none;
		margin: 0;
	}

	.buy-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 1;
		max-width: 240px;
		height: 48px;
		padding: 0 30px;
		background: var(--color-primary, #ffdd00);
		color: var(--dark, #333);
		border: none;
		border-radius: 6px;
		font-size: 1rem;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.2s, transform 0.1s;
	}

	.buy-btn:hover:not(:disabled) {
		background: #e6c700;
		transform: translateY(-1px);
	}

	.buy-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	/* Атрибуты */
	.product-attributes {
		margin-top: 20px;
	}

	.product-attributes h3 {
		font-size: 1rem;
		margin: 0 0 10px;
	}

	.product-attributes table {
		width: 100%;
		border-collapse: collapse;
	}

	.product-attributes td {
		padding: 8px 12px;
		border-bottom: 1px solid #eee;
		font-size: 0.9rem;
	}

	.attr-name {
		color: #666;
		width: 40%;
	}

	.attr-value {
		font-weight: 500;
	}

	/* Описание */
	.product-description {
		border-top: 1px solid #eee;
		padding-top: 25px;
		margin-top: 10px;
	}

	.product-description h3 {
		font-size: 1.1rem;
		margin: 0 0 12px;
	}

	.desc-content {
		line-height: 1.7;
		color: #444;
	}

	/* Похожие товары */
	.related-products {
		border-top: 1px solid #eee;
		padding-top: 25px;
		margin-top: 25px;
	}

	.related-products h3 {
		font-size: 1.1rem;
		margin: 0 0 15px;
	}

	/* Адаптив */
	@media (max-width: 768px) {
		.product-main {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.product-gallery {
			position: static;
		}
	}
</style>

<script>
	// Переключение изображений в галерее
	const thumbs = document.querySelectorAll<HTMLButtonElement>('.thumb');
	const mainImage = document.getElementById('main-image') as HTMLImageElement | null;

	if (mainImage && thumbs.length > 0) {
		thumbs.forEach((thumb) => {
			thumb.addEventListener('click', () => {
				const src = thumb.dataset.src;
				const alt = thumb.dataset.alt;
				if (src && mainImage) {
					mainImage.src = src;
					if (alt) mainImage.alt = alt;
					thumbs.forEach((t) => t.classList.remove('active'));
					thumb.classList.add('active');
				}
			});
		});
	}
</script>
