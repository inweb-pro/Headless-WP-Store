---
import Layout from '../components/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const orderNumber = Astro.url.searchParams.get('order') || '';
const orderTotal = Astro.url.searchParams.get('total') || '';
---

<Layout title="Заказ успешно оформлен">
	<div class="container order-received-container">
		<Breadcrumbs items={[{ name: "Заказ оформлен", uri: "/order-received" }]} />

		<div class="success-card">
			<div class="success-icon-wrap">
				<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="2">
					<circle cx="12" cy="12" r="10"></circle>
					<path d="M8 12l3 3 6-6"></path>
				</svg>
			</div>

			<h1 class="success-title">Спасибо за ваш заказ!</h1>

			{orderNumber && (
				<div class="order-badge-row">
					<span class="order-num-badge">Номер заказа: <strong>#{orderNumber}</strong></span>
					{orderTotal && <span class="order-total-badge">Сумма: <strong>{orderTotal}</strong></span>}
				</div>
			)}

			<div class="instructions-box">
				<h3>Что происходит дальше?</h3>
				<ol>
					<li>
						<strong>Подтверждение наличия:</strong> Наш менеджер проверит деталь на складе и свяжется с вами по указанному номеру телефона для подтверждения заказа.
					</li>
					<li>
						<strong>Оплата:</strong> Если вы выбрали оплату картой — реквизиты для перевода на карту Сбербанка будут отправлены вам в сообщении после согласования заказа.
					</li>
					<li>
						<strong>Отправка:</strong> Заказ будет надежно упакован и передан в выбранную транспортную компанию. Трек-номер для отслеживания мы вышлем вам сразу после отправки.
					</li>
				</ol>
			</div>

			<div class="actions-row">
				<a href="/shop" class="btn-primary">Вернуться в каталог</a>
				<a href="/" class="btn-secondary">На главную</a>
			</div>
		</div>
	</div>
</Layout>

<style>
	.order-received-container {
		max-width: 800px;
		margin: 30px auto 80px;
		padding: 0 15px;
	}

	.success-card {
		background: #fff;
		border: 1px solid #eee;
		border-radius: 12px;
		padding: 40px 30px;
		text-align: center;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
	}

	.success-icon-wrap {
		margin-bottom: 15px;
	}

	.success-title {
		font-family: "Play", sans-serif;
		font-size: 2rem;
		margin: 0 0 20px;
		color: #222;
	}

	.order-badge-row {
		display: flex;
		gap: 15px;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 30px;
	}

	.order-num-badge, .order-total-badge {
		background: #fdfae6;
		border: 1px solid #ffdd00;
		padding: 10px 18px;
		border-radius: 6px;
		font-size: 15px;
		color: #333;
	}

	.instructions-box {
		text-align: left;
		background: #fafafa;
		border: 1px solid #eee;
		border-radius: 8px;
		padding: 24px 30px;
		margin-bottom: 35px;
	}

	.instructions-box h3 {
		font-family: "Play", sans-serif;
		font-size: 1.15rem;
		margin: 0 0 15px;
		color: #222;
	}

	.instructions-box ol {
		margin: 0;
		padding-left: 20px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: 14px;
		color: #444;
		line-height: 1.5;
	}

	.actions-row {
		display: flex;
		gap: 15px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn-primary {
		background: var(--color-primary, #ffdd00);
		color: #1a1a1a;
		padding: 12px 28px;
		border-radius: 6px;
		font-weight: 700;
		text-decoration: none;
		font-size: 14px;
		transition: background 0.2s;
	}

	.btn-primary:hover {
		background: #e6c700;
	}

	.btn-secondary {
		background: #fff;
		color: #555;
		border: 1px solid #ddd;
		padding: 12px 28px;
		border-radius: 6px;
		font-weight: 600;
		text-decoration: none;
		font-size: 14px;
		transition: background 0.2s;
	}

	.btn-secondary:hover {
		background: #f5f5f5;
	}
</style>
