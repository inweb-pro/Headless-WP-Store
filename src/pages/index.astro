---
/**
 * Главная страница — последние поступления.
 * Commit 1.1: Переведено на GraphQL-клиент с обработкой ошибок.
 */
import PageLayout from "../layouts/PageLayout.astro";
import ProductFeed from "../components/ProductFeed.astro";
import { fetchGraphQL } from "../lib/graphql";
import { GET_LATEST_PRODUCTS } from "../lib/queries/products";
import type { ProductBase } from "../lib/types";

interface LatestProductsData {
	products: { nodes: ProductBase[] };
}

let latestProducts: ProductBase[] = [];
let error: string | null = null;

try {
	const data = await fetchGraphQL<LatestProductsData>(GET_LATEST_PRODUCTS, { first: 5 });
	latestProducts = data.products?.nodes || [];
} catch (e) {
	error = (e as Error).message;
	console.error('[index] Ошибка загрузки товаров:', error);
}
---

<PageLayout title="Главная">
	<section class="hero">
		<h1>MotoPuzzle</h1>
		<p>Запчасти для мотоциклов BMW и не только.</p>
	</section>

	<section class="featured">
		<h2>Новые поступления</h2>
		{error ? (
			<p class="error-message">Не удалось загрузить товары. Попробуйте позже.</p>
		) : (
			<ProductFeed products={latestProducts} skeletonCount={5} priorityCount={2} />
		)}
	</section>
</PageLayout>
