---
// src/components/ProductCard.astro
const { product } = Astro.props;
const price = product.price || "Цена по запросу";
---

<article class="product-card">
	<div class="product-card__inner">
		<div class="image-wrapper">
			<img
				src={product.image?.sourceUrl || "/placeholder.jpg"}
				alt={product.name}
				loading="lazy"
			/>
			<button class="wishlist-btn" aria-label="Добавить в избранное">
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
				>
					<path
						d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.84-8.84 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
					></path>
				</svg>
			</button>
		</div>

		<div class="product-info">
			<h3 class="product-name">
				<a href={product.uri} class="product-link">
					{product.name}
				</a>
			</h3>
			<p class="product-price" set:html={price} />
		</div>

		<div class="cart-action">
			<button class="add-to-cart-btn">
				<span class="btn-content-wrapper">
					<span class="btn-text">В КОРЗИНУ</span>
					<span class="btn-icon">
						<svg
							width="22"
							height="22"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<circle cx="9" cy="21" r="1"></circle>
							<circle cx="20" cy="21" r="1"></circle>
							<path
								d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
							></path>
						</svg>
					</span>
				</span>
			</button>
		</div>
	</div>
</article>

<style lang="scss">
	.product-card {
		position: relative;
		z-index: 1;

		&__inner {
			background: #fff;
			border: 1px solid #eee;
			border-radius: 15px;
			padding: 5px;
			display: flex;
			flex-direction: column;
			transition: all 0.3s ease;
			position: relative;
		}

		&:hover {
			z-index: 10;

			.product-card__inner {
				box-shadow: 0 10px 50px rgba(0, 0, 0, 0.3); // 0.12
				transform: translateY(-22px) scale(1.1);
				// Чтобы карточка визуально "наплывала" на нижние,
				// мы не меняем ее размер, а расширяем за счет абсолютной кнопки
			}

			// При наведении на карточку — увеличиваем картинку
			.image-wrapper img {
				transform: scale(1.1); // Умеренный зум
			}
			.product-name {
				text-decoration: underline;
				text-decoration-color: var(--color-primary);
				text-decoration-thickness: 2px;
				text-underline-offset: 3px;
			}

			.cart-action {
				opacity: 1;
				visibility: visible;
				transform: translateY(0);
			}

			.wishlist-btn {
				opacity: 1;
				transform: scale(1);
			}
		}

		.image-wrapper {
			position: relative;
			aspect-ratio: 320 / 200;
			overflow: hidden;
			background-color: #f9f9f9;
			border-top-left-radius: 10px;
			border-top-right-radius: 10px;
			margin-bottom: 10px;

			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.8s cubic-bezier(0.2, 1, 0.3, 1);
			}
		}

		.product-info {
			text-align: center;
			padding-bottom: 5px;
		}

		.product-name {
			font-family: "Play";
			font-size: 1rem;
			margin: 0 5px 10px;
			line-height: 1.4;
			height: 2.8em; /* 1.4 (line-height) * 3 (строки) = фиксируем высоту */

			.product-link {
				color: #222;
				text-decoration: none;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;

				&::after {
					content: "";
					position: absolute;
					top: 0;
					left: 0;
					right: 0;
					bottom: 0;
					z-index: 1;
				}
			}
		}

		.product-price {
			margin: auto 0 10px;
			color: #e44d26; // e82e28
			font-weight: 700;
			font-size: 1rem;
		}

		/* --- Кнопка корзины (Выпадающая) --- */
		.cart-action {
			position: absolute;
			top: calc(100% - 11px); // Сразу под границей карточки
			left: -1px;
			right: -1px;
			background: #fff;
			border: 1px solid #eee;
			border-top: none;
			border-radius: 0 0 15px 15px;
			padding: 0 12px 12px;
			opacity: 0;
			visibility: hidden;
			transform: translateY(-10px);
			transition: all 0.3s ease;
			box-shadow: 0 20px 30px rgba(0, 0, 0, 0.12);
			z-index: 11;
		}

		.add-to-cart-btn {
			width: 130px;
			height: 40px;
			background: var(--color-primary, #ffdd00);
			border: none;
			border-radius: 8px;
			cursor: pointer;
			overflow: hidden;
			position: relative;
			left: calc(50% - 65px);
			z-index: 12;

			.btn-content-wrapper {
				display: block;
				width: 100%;
				height: 100%;
				position: relative;
			}

			.btn-text,
			.btn-icon {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-weight: 700;
				transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
			}

			.btn-icon {
				transform: translateY(100%); // Скрыта внизу
			}

			&:hover {
				.btn-text {
					transform: translateY(-100%);
				} // Текст уходит вверх
				.btn-icon {
					transform: translateY(0);
				} // Иконка встает на место
			}
		}

		.wishlist-btn {
			position: absolute;
			top: 10px;
			right: 10px;
			z-index: 15;
			background: #fff;
			border: none;
			border-radius: 50%;
			width: 34px;
			height: 34px;
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 0;
			transform: scale(0.8);
			transition: all 0.2s ease;
			cursor: pointer;
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);

			&:hover {
				color: #e44d26;
			}
		}
	}
</style>
