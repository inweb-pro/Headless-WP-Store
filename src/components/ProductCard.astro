---
const { product } = Astro.props;
const price = product.price || "Цена по запросу"; 
---

<article class="product-card">
  <a href={product.uri} class="product-link">
    <div class="image-wrapper">
      <img 
        src={product.image?.sourceUrl || '/placeholder.jpg'} 
        alt={product.name} 
        loading="lazy" 
      />
    </div>
    <h3 class="product-name">{product.name}</h3>
    <p class="product-price" set:html={price}></p>
  </a>
</article>