---
interface Props {
  cursor?: string;
  slug?: string;
}
const { cursor, slug } = Astro.props;
---

<button 
  id="load-more-btn" 
  class="load-more-btn" 
  data-cursor={cursor} 
  data-slug={slug}
>
  <span class="btn-default-content">
    <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
    Показать ещё
    <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
  </span>
  <span class="btn-loading-content" style="display: none;">
    <svg class="spinner" width="20" height="20" viewBox="0 0 50 50"><circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle></svg>
    Загрузка...
  </span>
</button>

<script>
  import { initLoadMore } from "../scripts/load-more.js";

  // Инициализация работает и при первой загрузке, и при переходах
  initLoadMore();
  // document.addEventListener("astro:page-load", initLoadMore);
</script>