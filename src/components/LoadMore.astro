---
interface Props {
  id?: string;
  cursor?: string;
  slug?: string;
  api?: string;
}

const { id = "load-more-btn", cursor, slug, api } = Astro.props;
---

<button 
  id={id} 
  class="load-more-btn" 
  data-cursor={cursor} 
  data-slug={slug} 
  data-api={api}
>
  <span class="btn-default-content">
    <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
    Показать ещё
    <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
  </span>
  
  <span class="btn-loading-content" style="display: none;">
    <svg class="spinner" width="20" height="20" viewBox="0 0 50 50">
      <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
    </svg>
    Загрузка...
  </span>
</button>

<style>

</style>