<!--
	SortSelect — кастомный селект сортировки.

	Выглядит как select, но с красивым popup-dropdown.
	Без JS — fallback на обычные ссылки.
	С JS — плавный dropdown с анимацией.
-->

<div class="sort-select" id="sort-select">
	<button type="button" class="sort-trigger" id="sort-trigger">
		<span class="sort-trigger-label">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M3 6h18M6 12h12M9 18h6"></path>
			</svg>
			<span id="sort-current">{Astro.props.currentLabel || 'Новые'}</span>
		</span>
		<svg class="sort-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M6 9l6 6 6-6"></path>
		</svg>
	</button>

	<div class="sort-dropdown" id="sort-dropdown">
		{Object.entries(Astro.props.options || {}).map(([key, opt]: [string, any]) => (
			<a
				href={`${Astro.props.baseUrl || '/shop'}?sort=${key}`}
				class={`sort-option ${Astro.props.currentKey === key ? 'is-selected' : ''}`}
				data-sort={key}
			>
				<span class="sort-option-label">{opt.label}</span>
				{Astro.props.currentKey === key && (
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
						<path d="M5 13l4 4L19 7"></path>
					</svg>
				)}
			</a>
		))}
	</div>
</div>

<style>
	.sort-select {
		position: relative;
	}

	.sort-trigger {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 14px;
		background: #fff;
		border: 1px solid #e0e0e0;
		border-radius: 6px;
		cursor: pointer;
		font-size: 13px;
		color: var(--dark, #333);
		transition: all 0.2s;
		white-space: nowrap;
	}

	.sort-trigger:hover {
		border-color: var(--color-primary, #ffdd00);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
	}

	.sort-trigger-label {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.sort-chevron {
		transition: transform 0.2s;
	}

	.sort-select.is-open .sort-chevron {
		transform: rotate(180deg);
	}

	.sort-dropdown {
		display: none;
		position: absolute;
		top: calc(100% + 6px);
		right: 0;
		min-width: 200px;
		background: #fff;
		border: 1px solid #e0e0e0;
		border-radius: 8px;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
		z-index: 100;
		padding: 6px 0;
		opacity: 0;
		transform: translateY(-4px);
		transition: opacity 0.15s, transform 0.15s;
	}

	.sort-select.is-open .sort-dropdown {
		display: block;
		opacity: 1;
		transform: translateY(0);
	}

	.sort-option {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 10px 16px;
		text-decoration: none;
		color: #333;
		font-size: 13px;
		transition: background 0.12s;
	}

	.sort-option:hover {
		background: #f5f5f5;
	}

	.sort-option.is-selected {
		background: #fffde6;
		font-weight: 700;
		color: var(--dark, #333);
	}

	.sort-option.is-selected svg {
		color: var(--color-primary, #ffdd00);
	}
</style>

<script>
	const select = document.getElementById('sort-select');
	const trigger = document.getElementById('sort-trigger');
	const dropdown = document.getElementById('sort-dropdown');

	if (trigger && dropdown && select) {
		trigger.addEventListener('click', (e) => {
			e.stopPropagation();
			select.classList.toggle('is-open');
		});

		document.addEventListener('click', (e) => {
			if (!select.contains(e.target as Node)) {
				select.classList.remove('is-open');
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') select.classList.remove('is-open');
		});
	}
</script>
