---
/**
 * Sidebar — навигация по маркам и моделям мотоциклов.
 *
 * Структура категорий:
 *   Honda (16)         ← родительская категория (марка)
 *   ├── CBR-1100 (3)   ← дочерняя категория (модель)
 *   ├── VT600C (2)
 *   └── ...
 *
 * Commit 1.1: Переведено на GraphQL-клиент.
 */
import { fetchGraphQL } from "../lib/graphql";
import { GET_SIDEBAR_CATEGORIES } from "../lib/queries/categories";
import type { SidebarCategoriesResult, CategoryNode } from "../lib/types";

const { pathname } = Astro.url;
const normalize = (path: string) => path?.replace(/^\/|\/$/g, "") || "";
const currentPath = normalize(pathname);

const response = await fetch(import.meta.env.WORDPRESS_API_URL, {
	method: "POST",
	headers: { "Content-Type": "application/json" },
	body: JSON.stringify({
		query: `
      query GetSideBarCategories {
        productCategories(where: { 
          parent: 0
        }, first: 100) {
          nodes {
            name
            uri
            slug
            count
            children(first: 100) {
              nodes {
                name
                uri
                slug
                count
              }
            }
          }
        }
      }
    `,
	}),
});

const { data } = await response.json();
const rawCategories = data?.productCategories?.nodes || [];
const categories = rawCategories
	.filter((cat: any) => cat.count > 0 && cat.slug !== 'uncategorized' && cat.name !== 'Uncategorized')
	.map((cat: any) => ({
		...cat,
		children: {
			nodes: (cat.children?.nodes || []).filter(
				(sub: any) => sub.count > 0 && sub.slug !== 'uncategorized' && sub.name !== 'Uncategorized'
			),
		},
	}));
---

<nav class="sidebar-nav">
	<h2 class="sidebar-title">Выберите марку/модель</h2>
	<div class="categories-scroll-area">
		<ul class="cat-list">
			{
				categories.map((cat) => {
					const catPath = normalize(cat.uri);

					// 1. Ветка открыта, если мы находимся внутри неё (startsWith)
					const isBranchOpen =
						currentPath.startsWith(catPath) && catPath !== "";

					// 2. Бейдж подсвечивается ТОЛЬКО если выбрана сама категория (точное совпадение)
					const isParentExact = currentPath === catPath;

					return (
						<li class={`cat-item ${isBranchOpen ? "is-open" : "is-closed"}`}>
							<div class="cat-header">
								<a
									href={cat.uri}
									class={`cat-link ${isParentExact ? "active" : ""}`}
								>
									{cat.name}
								</a>

								{/* Highlight только при точном совпадении с родителем */}
								<span class={`count-badge ${isParentExact ? "highlight" : ""}`}>
									{cat.count}
								</span>

								{cat.children && cat.children.nodes.length > 0 && (
									<button class="toggle-btn" aria-label="Toggle submenu">
										<svg viewBox="0 0 24 24" width="18" height="18">
											<path d="M7 10l5 5 5-5z" />
										</svg>
									</button>
								)}
							</div>

							{cat.children && cat.children.nodes.length > 0 && (
								<ul class="sub-cat-list">
									{cat.children.nodes.map((sub) => {
										const subPath = normalize(sub.uri);
										// Подкатегория активна, если текущий путь начинается с её пути
										const isSubActive =
											currentPath.startsWith(subPath) && subPath !== "";

										return (
											<li class="sub-cat-item">
												<a
													href={sub.uri}
													class={isSubActive ? "sub-active" : ""}
												>
													{sub.name}
												</a>

												<span
													class={`count-badge small ${isSubActive ? "highlight" : ""}`}
												>
													{sub.count}
												</span>
											</li>
										);
									})}
								</ul>
							)}
						</li>
					);
				})
			}
		</ul>
	</div>
</nav>

<script is:inline>
	(function () {
		// 1. Сворачивание / разворачивание категорий
		document.querySelectorAll(".toggle-btn").forEach(function (btn) {
			btn.addEventListener("click", function () {
				var parent = btn.closest(".cat-item");
				if (parent) {
					parent.classList.toggle("is-open");
				}
			});
		});

		// 2. Автоматическая прокрутка активной категории/подкатегории в видимую область сайдбара
		function scrollActiveCategoryIntoView() {
			var scrollArea = document.querySelector(".categories-scroll-area");
			if (!scrollArea) return;

			var activeLink = scrollArea.querySelector(".sub-active, .cat-link.active");
			if (!activeLink) return;

			var targetItem =
				activeLink.closest(".sub-cat-item") ||
				activeLink.closest(".cat-item") ||
				activeLink;
			if (!targetItem) return;

			var containerRect = scrollArea.getBoundingClientRect();
			var itemRect = targetItem.getBoundingClientRect();

			// Проверяем, выходит ли активный элемент за границы видимой области контейнера
			var isAbove = itemRect.top < containerRect.top;
			var isBelow = itemRect.bottom > containerRect.bottom;

			if (isAbove || isBelow) {
				var targetScrollTop =
					scrollArea.scrollTop +
					(itemRect.top - containerRect.top) -
					containerRect.height / 2 +
					itemRect.height / 2;

				scrollArea.scrollTo({
					top: Math.max(0, targetScrollTop),
					behavior: "smooth",
				});
			}
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", function () {
				setTimeout(scrollActiveCategoryIntoView, 80);
			});
		} else {
			setTimeout(scrollActiveCategoryIntoView, 80);
		}
	})();
</script>
