			</div>
		</div>
	</div>

	<div class="middle-header">
		<div class="container middle-inner">
			<div class="mobile-toggle" data-offcanvas-toggle="mobile-menu">
				<svg class="icon" width="24" height="24">
					<use href="/ui-icons.svg#menu"></use>
				</svg>
				<span>Меню</span>
			</div>

			<a href="/" class="logo" aria-label="MotoPuzzle - Главная">
				<img
					src="/logo-dark.svg"
					alt="MotoPuzzle Logo"
					width="210"
					height="60"
					fetchpriority="high"
					loading="eager"
					decoding="async"
				/>
