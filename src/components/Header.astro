---
import HeaderSearch from "./HeaderSearch.astro";
import Offcanvas from "./Offcanvas.astro";
import "../styles/header.css"; // Подключаем общие стили
---

<header class="main-header">
	<div class="top-bar">
		<div class="container top-bar-inner">
			<div class="top-left">
				<a href="tel:+79030936556" class="contact-link">
					<svg class="icon" width="18" height="18">
						<use href="/ui-icons.svg#phone--voice--filled"></use>
					</svg>
					+7 (903) 093-65-56
				</a>
				<a href="mailto:info@motopuzzle.net" class="contact-link">
					<svg class="icon" width="18" height="18">
						<use href="/ui-icons.svg#envelope-solid"></use>
					</svg>
					info@motopuzzle.net
				</a>
			</div>
			<div class="top-right">
				<div class="top-nav-links">
					<a href="/about">О компании</a>|<a href="/blog">Новости</a>
				</div>
				<div class="socials">
					<a
						rel="nofollow"
						href="https://vk.com/motopuzzle"
						target="_blank"
						class="soc-vk"
					>
						<svg class="icon" width="20" height="20">
							<use href="/ui-icons.svg#vk"></use>
						</svg>
					</a>
					<a
						rel="nofollow"
						href="https://www.instagram.com/motopuzzle_net/"
						target="_blank"
						class="soc-ig"
					>
						<svg class="icon" width="20" height="20">
							<use href="/ui-icons.svg#instagram"></use>
						</svg>
					</a>
					<a
						rel="nofollow"
						href="https://api.whatsapp.com/send?phone=79030936556"
						target="_blank"
						class="soc-wa"
					>
						<svg class="icon" width="20" height="20">
							<use href="/ui-icons.svg#whatsapp"></use>
						</svg>
					</a>
					<a
						rel="nofollow"
						href="https://t.me/Turbo_Vadik"
						target="_blank"
						class="soc-tg"
					>
						<svg class="icon" width="20" height="20">
							<use href="/ui-icons.svg#telegram"></use>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="middle-header">
		<div class="container middle-inner">
			<div class="mobile-toggle" data-offcanvas-toggle="mobile-menu">
				<svg class="icon" width="24" height="24">
					<use href="/ui-icons.svg#menu"></use>
				</svg>
				<span>Меню</span>
			</div>

			<a href="/" class="logo" aria-label="MotoPuzzle - Главная">
				<img
					src="/logo-dark.svg"
					alt="MotoPuzzle Logo"
					width="210"
					height="60"
					fetchpriority="high"
					loading="eager"
					decoding="async"
				/>
			</a>

			<div class="desktop-search">
				<HeaderSearch />
			</div>

			<div class="header-actions">
				<a href="/my-account" class="action-item user-acc">
					<svg class="icon" width="26" height="26">
						<use href="/ui-icons.svg#user"></use>
					</svg>
					<span>Личный кабинет</span>
				</a>

				<a href="/wishlist" class="action-item">
					<div class="icon-badge">
						<svg class="icon" width="26" height="26">
							<use href="/ui-icons.svg#heart"></use>
						</svg>
						<span class="badge yellow">1</span>
					</div>
				</a>

				<div class="action-item cart-total" data-offcanvas-toggle="cart-panel">
					<div class="icon-badge">
						<svg class="icon" width="28" height="28">
							<use href="/ui-icons.svg#shopping-cart"></use>
						</svg>
						<span class="badge yellow">2</span>
					</div>
					<span class="price">8 000 ₽</span>
				</div>

				<div class="mobile-actions">
					<div
						data-offcanvas-toggle="mobile-menu"
						data-focus-id="mobile-search-input"
					>
						<svg class="nav-icon" width="26" height="26">
							<use href="/ui-icons.svg#search"></use>
						</svg>
					</div>
					<div class="icon-badge">
						<div data-offcanvas-toggle="cart-panel">
							<svg class="icon" width="26" height="26">
								<use href="/ui-icons.svg#shopping-cart"></use>
							</svg>
							<span class="badge yellow">2</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<nav class="bottom-nav desktop-only">
		<div class="container">
			<ul class="nav-list">
				<li class="nav-item">
					<a href="/shop">
						<svg class="nav-icon" width="18" height="18">
							<use href="/ui-icons.svg#cog"></use>
						</svg>
						<span>Каталог запчастей</span>
					</a>
				</li>
				<li class="nav-item">
					<a href="/motopodbor">
						<svg class="nav-icon" width="21" height="21">
							<use href="/ui-icons.svg#asset--view"></use>
						</svg>
						<span>Мотоподбор</span>
					</a>
				</li>
				<li class="nav-item">
					<a href="/motoservis">
						<svg class="nav-icon" width="21" height="21">
							<use href="/ui-icons.svg#wrench"></use>
						</svg>
						<span>Мотосервис</span>
					</a>
				</li>
				<li class="nav-item">
					<a href="/motoevakuator">
						<svg class="nav-icon" width="21" height="21">
							<use href="/ui-icons.svg#delivery-truck"></use>
						</svg>
						<span>Мотоэвакуатор</span>
					</a>
				</li>
				<li class="nav-item">
					<a href="/contacts">
						<svg class="nav-icon" width="20" height="20">
							<use href="/ui-icons.svg#map"></use>
						</svg>
						<span>Контакты</span>
					</a>
				</li>
				<li class="nav-item sell-moto">
					<a href="/vykup-motociklov">
						<svg class="nav-icon" width="22" height="22">
							<use href="/ui-icons.svg#motorcycle--fill"></use>
						</svg>
						<span>Продать мотоцикл</span>
					</a>
				</li>
			</ul>
		</div>
	</nav>

	<Offcanvas id="mobile-menu" side="left">
		<div class="mobile-menu-container">
			<div class="mobile-search-area">
				<div class="search-field">
					<input
						type="text"
						id="mobile-search-input"
						placeholder="Поиск запчастей в каталоге"
					/>
					<svg class="search-icon" width="22" height="22">
						<use href="/ui-icons.svg#search"></use>
					</svg>
				</div>
				<button class="where-to-search">
					ГДЕ ИСКАТЬ? <svg
						width="12"
						height="12"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
					>
				</button>
			</div>

			<nav class="mobile-nav-list">
				<a href="/" class="mobile-nav-item">
					<span class="mobile-nav-content">
						<svg class="mobile-nav-icon" width="18" height="18">
							<use href="/ui-icons.svg#home"></use>
						</svg>
						<span>Главная</span>
					</span>
				</a>
				<a href="/shop" class="mobile-nav-item">
					<span class="mobile-nav-content">
						<svg class="mobile-nav-icon" width="18" height="18">
							<use href="/ui-icons.svg#cog"></use>
						</svg>
						<span>Каталог запчастей</span>
					</span>
				</a>

				<div class="mobile-nav-item mobile-has-dropdown">
					<div class="mobile-nav-content">
						<a href="/about">
							<svg class="mobile-nav-icon" width="20" height="20">
								<use href="/ui-icons.svg#puzzle-piece"></use>
							</svg>
							<span>О компании</span>
						</a>
					</div>
					<button class="mobile-dropdown-toggle" aria-label="Раскрыть">
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="#333"
							stroke-width="2"
							><polyline points="9 18 15 12 9 6"></polyline></svg
						>
					</button>
					<ul class="mobile-submenu">
						<li><a href="/reviews"><span>Отзывы</span></a></li>
						<li><a href="/blog"><span>Новости</span></a></li>
						<li>
							<a href="/payment-and-delivery"><span>Оплата и доставка</span></a>
						</li>
					</ul>
				</div>

				<a href="/motopodbor" class="mobile-nav-item">
					<span class="mobile-nav-content">
						<svg class="mobile-nav-icon" width="21" height="21">
							<use href="/ui-icons.svg#asset--view"></use>
						</svg>
						<span>Мотоподбор</span>
					</span>
				</a>

				<a href="/motoservis" class="mobile-nav-item">
					<span class="mobile-nav-content">
						<svg class="mobile-nav-icon" width="21" height="21">
							<use href="/ui-icons.svg#wrench"></use>
						</svg>
						<span>Мотосервис</span>
					</span>
				</a>

				<a href="/motoevakuator" class="mobile-nav-item">
					<span class="mobile-nav-content">
						<svg class="mobile-nav-icon" width="21" height="21">
							<use href="/ui-icons.svg#delivery-truck"></use>
						</svg>
						<span>Мотоэвакуатор</span>
					</span>
				</a>

				<a href="/vykup-motociklov" class="mobile-nav-item">
					<span class="mobile-nav-content">
						<svg class="mobile-nav-icon" width="20" height="20">
							<use href="/ui-icons.svg#motorcycle--fill"></use>
						</svg>
						<span>Продать мотоцикл</span>
					</span>
				</a>

				<a href="/contacts" class="mobile-nav-item">
					<span class="mobile-nav-content">
						<svg class="mobile-nav-icon" width="19" height="19">
							<use href="/ui-icons.svg#map"></use>
						</svg>
						<span>Контакты</span>
					</span>
				</a>

				<div class="mobile-nav-item mobile-has-dropdown">
					<div class="mobile-nav-content">
						<a href="/my-account">
							<svg class="mobile-nav-icon" width="19" height="19">
								<use href="/ui-icons.svg#user"></use>
							</svg>
							<span>Личный кабинет</span></a
						>
					</div>
					<button class="mobile-dropdown-toggle" aria-label="Раскрыть">
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="#333"
							stroke-width="2"
							><polyline points="9 18 15 12 9 6"></polyline></svg
						>
					</button>
					<ul class="mobile-submenu">
						<li><a href="/orders"><span>Заказы</span></a></li>
						<li><a href="/wishlist"><span>Избранное</span></a></li>
						<li><a href="/edit-address"><span>Адрес доставки</span></a></li>
						<li><a href="/edit-account"><span>Настройки</span></a></li>
						<li><a href="/customer-logout"><span>Выйти</span></a></li>
					</ul>
				</div>
			</nav>
		</div>
	</Offcanvas>

	<Offcanvas id="cart-panel" side="right" title="КОРЗИНА">
		<p>Ваша корзина пока пуста...</p>
	</Offcanvas>

	<Offcanvas id="login-panel" side="right" title="ВХОД">
		<form>
			<input type="text" placeholder="Логин" />
			<button type="submit">Войти</button>
		</form>
	</Offcanvas>

	<div class="sticky-header" id="sticky-header">
		<div class="container sticky-inner">
			<div class="mobile-toggle" data-offcanvas-toggle="mobile-menu">
				<svg class="icon" width="24" height="24">
					<use href="/ui-icons.svg#menu"></use>
				</svg>
				<span>Меню</span>
			</div>
			<a href="/" class="sticky-logo" aria-label="MotoPuzzle - Главная">
				<img
					src="/logo-dark.svg"
					alt="MotoPuzzle Logo"
					width="170"
					height="50"
					fetchpriority="high"
					loading="eager"
					decoding="async"
				/>
			</a>

			<nav class="sticky-nav desktop-only">
				<ul class="nav-list">
					<li class="nav-item">
						<a href="/shop">
							<svg class="nav-icon" width="18" height="18"
								><use href="/ui-icons.svg#cog"></use></svg
							>
							<span>Каталог запчастей</span>
						</a>
					</li>
					<li class="nav-item has-dropdown">
						<a href="/motoservis">
							<svg class="nav-icon" width="21" height="21"
								><use href="/ui-icons.svg#wrench"></use></svg
							>
							<span>Услуги мотосервиса</span>
							<svg
								class="dropdown-arrow"
								width="12"
								height="12"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
							>
								<path d="M6 9l6 6 6-6"></path>
							</svg>
						</a>
						<ul class="dropdown-menu">
							<li>
								<a href="/motopodbor">
									<svg class="nav-icon" width="21" height="21"
										><use href="/ui-icons.svg#asset--view"></use></svg
									>
									<span>Мотоподбор</span>
								</a>
							</li>
							<li>
								<a href="/motoevakuator">
									<svg class="nav-icon" width="21" height="21"
										><use href="/ui-icons.svg#delivery-truck"></use></svg
									>
									<span>Мотоэвакуатор</span>
								</a>
							</li>
						</ul>
					</li>
					<li class="nav-item">
						<a href="/contacts">
							<svg class="nav-icon" width="18" height="18"
								><use href="/ui-icons.svg#map"></use></svg
							>
							<span>Контакты</span>
						</a>
					</li>
				</ul>
			</nav>

			<div class="sticky-actions">
				<div
					class="action-item"
					data-offcanvas-toggle="mobile-menu"
					data-focus-id="mobile-search-input"
				>
					<svg class="nav-icon" width="26" height="26">
						<use href="/ui-icons.svg#search"></use>
					</svg>
				</div>

				<div class="action-item user-acc">
					<svg class="icon" width="26" height="26"
						><use href="/ui-icons.svg#user"></use></svg
					>
				</div>

				<!-- <div class="action-item">
					<div class="icon-badge">
						<svg class="icon" width="26" height="26"><use href="/ui-icons.svg#heart"></use></svg>
						<span class="badge yellow">1</span>
					</div>
				</div> -->

				<div class="action-item cart-total" data-offcanvas-toggle="cart-panel">
					<div class="icon-badge">
						<svg class="icon" width="28" height="28"
							><use href="/ui-icons.svg#shopping-cart"></use></svg
						>
						<span class="badge yellow">2</span>
					</div>
					<span class="price">8 000 ₽</span>
				</div>

				<div class="mobile-actions">
					<div
						data-offcanvas-toggle="mobile-menu"
						data-focus-id="mobile-search-input"
					>
						<svg class="nav-icon" width="26" height="26">
							<use href="/ui-icons.svg#search"></use>
						</svg>
					</div>
					<div class="icon-badge">
						<div data-offcanvas-toggle="cart-panel">
							<svg class="icon" width="26" height="26">
								<use href="/ui-icons.svg#shopping-cart"></use>
							</svg>
							<span class="badge yellow">2</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script>
		// Импортируем логики
		import { initOffcanvas } from "../scripts/offcanvas.js";
		import { initMobileSubmenus } from "../scripts/mobile-menu.js";
		import { initStickyHeader } from "../scripts/sticky-header.js";
		import { initActiveMenu } from "../scripts/active-menu.js";

		// Инициализируем при загрузке страницы (поддержка Astro View Transitions)
		// document.addEventListener("astro:page-load", () => {
		initOffcanvas();
		initMobileSubmenus();
		initStickyHeader();
		initActiveMenu();
		// });
	</script>
</header>
