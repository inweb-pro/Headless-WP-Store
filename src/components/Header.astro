---
import HeaderSearch from "./HeaderSearch.astro";
import Offcanvas from "./Offcanvas.astro";
import "../styles/header.css"; // Подключаем общие стили
import { fetchGraphQL } from "../lib/graphql";
import { GET_SIDEBAR_CATEGORIES } from "../lib/queries/categories";
import type { SidebarCategoriesResult, CategoryNode } from "../lib/types";

let categories: CategoryNode[] = [];
try {
	const data = await fetchGraphQL<SidebarCategoriesResult>(GET_SIDEBAR_CATEGORIES);
	categories = (data.productCategories?.nodes || []).filter((c) => c.count > 0);
} catch (e) {
	console.error('[Header] Ошибка загрузки категорий для мобильного поиска:', (e as Error).message);
}
---

<header class="main-header">
	<div class="top-bar">
		<div class="container top-bar-inner">
			<div class="top-left">
				<a href="tel:+79030936556" class="contact-link">
					<svg class="icon" width="18" height="18">
						<use href="/ui-icons.svg#phone--voice--filled"></use>
					</svg>
					+7 (903) 093-65-56
				</a>
				<a href="mailto:info@motopuzzle.net" class="contact-link">
					<svg class="icon" width="18" height="18">
						<use href="/ui-icons.svg#envelope-solid"></use>
					</svg>
					info@motopuzzle.net
				</a>
			</div>
			<div class="top-right">
				<div class="top-nav-links">
					<a href="/about">О компании</a>|<a href="/blog">Новости</a>
				</div>
				<div class="socials">
					<a
						rel="nofollow"
						href="https://vk.com/motopuzzle"
						target="_blank"
						class="soc-vk"
					>
						<svg class="icon" width="20" height="20">
							<use href="/ui-icons.svg#vk"></use>
						</svg>
					</a>
					<a
						rel="nofollow"
						href="https://www.instagram.com/motopuzzle_net/"
						target="_blank"
						class="soc-ig"
					>
						<svg class="icon" width="20" height="20">
							<use href="/ui-icons.svg#instagram"></use>
						</svg>
					</a>
					<a
						rel="nofollow"
						href="https://api.whatsapp.com/send?phone=79030936556"
						target="_blank"
						class="soc-wa"
					>
						<svg class="icon" width="20" height="20">
							<use href="/ui-icons.svg#whatsapp"></use>
						</svg>
					</a>
					<a
						rel="nofollow"
						href="https://t.me/Turbo_Vadik"
						target="_blank"
						class="soc-tg"
					>
						<svg class="icon" width="20" height="20">
							<use href="/ui-icons.svg#telegram"></use>
