---
const { title } = Astro.props;
import Header from './Header.astro';
import '../styles/global.css'; // Подключаем общие стили

import "@fontsource/pt-sans-caption/400.css"; // шрифты
import "@fontsource/pt-sans-caption/700.css";
import "@fontsource/play/400.css";
import "@fontsource/play/700.css";
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | MotoPuzzle</title>
  </head>
  <body>

    <Header />
    <slot />

    <footer class="main-footer">
      <div class="container">
        <p>&copy; 2026 MotoPuzzle - Запчасти и аксессуары</p>
      </div>
    </footer>
  </body>
</html>