---
import "@fontsource/pt-sans-caption/400.css"; // шрифты
import "@fontsource/pt-sans-caption/700.css";
import "@fontsource/play/400.css";
import "@fontsource/play/700.css";

import '../styles/global.css'; // Подключаем общие стили
import "../styles/shop.css"; // Стили магазина

import Header from './Header.astro';
import Footer from './Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import SEO from './SEO.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'product' | 'article';
	canonical?: string;
	product?: any;
	breadcrumbs?: Array<{ name: string; uri: string }>;
}

const { title, description, image, type, canonical, product, breadcrumbs } = Astro.props;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonical={canonical}
      product={product}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body>

    <Header />
    <main><slot /></main>
    <Footer />
    <BackToTop />

  </body>
</html>