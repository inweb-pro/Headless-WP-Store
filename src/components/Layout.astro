---
import "@fontsource/pt-sans-caption/400.css"; // шрифты
import "@fontsource/pt-sans-caption/700.css";
import "@fontsource/play/400.css";
import "@fontsource/play/700.css";

import '../styles/global.css'; // Подключаем общие стили

import Header from './Header.astro';
import Footer from './Footer.astro';
import BackToTop from '../components/BackToTop.astro';

const { title } = Astro.props;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | MotoPuzzle</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>

    <Header />
    <main><slot /></main>
    <Footer />
    <BackToTop />

  </body>
</html>