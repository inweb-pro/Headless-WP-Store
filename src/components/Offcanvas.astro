---
interface Props {
  id: string;
  side: 'left' | 'right';
  title?: string;
}

const { id, side, title } = Astro.props;
---

<div id={id} class={`offcanvas offcanvas-${side}`} aria-hidden="true">
  <div class="offcanvas-overlay" data-close-offcanvas></div>
  <div class="offcanvas-content">
    <div class="offcanvas-header">
      {title && <h3 class="offcanvas-title">{title}</h3>}
      <button class="close-btn" data-close-offcanvas aria-label="Закрыть">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="offcanvas-body">
      <slot />
    </div>
  </div>
</div>