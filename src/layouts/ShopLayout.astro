---
import Layout from "../components/Layout.astro";
import Sidebar from "../components/Sidebar.astro";

const { title } = Astro.props;
---

<Layout title={title}>
	<div class="container shop-layout">
		<aside class="shop-sidebar">
			<Sidebar />
		</aside>
		<div class="shop-main">
			<slot />
		</div>
	</div>
</Layout>