---
/**
 * PageLayout — обёртка для контентных страниц (О компании, Контакты и т.д.).
 */
import Layout from '../components/Layout.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'product' | 'article';
	breadcrumbs?: Array<{ name: string; uri: string }>;
}

const { title, description, image, type, breadcrumbs } = Astro.props;
---
<Layout title={title} description={description} image={image} type={type} breadcrumbs={breadcrumbs}>
  <div class="container page-content">
    <slot />
  </div>
</Layout>